# YiTian Learning Cosmos Docker environment

PROJECT_NAME=YiTianLearningCosmos
DEBUG=false
LOG_LEVEL=INFO

# Required for file_parse_agent and rag_agent
DASHSCOPE_API_KEY=
LLAMA_CLOUD_API_KEY=

# Required for code_agent / search_agent / research_agent / host-side integrations
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional for research agent. If empty, the project uses a fallback search path.
TAVILY_API_KEY=

# Internal service URLs used by the host/orchestrator parts of the project
FILE_PARSE_AGENT_URL=http://file-parse-agent:10001
CODE_AGENT_URL=http://code-agent:10002
RAG_AGENT_URL=http://rag-agent:10003
SEARCH_AGENT_URL=http://search-agent:10004
RESEARCH_AGENT_URL=http://research-agent:10005

# Search agent database
SEARCH_DB_HOST=postgres
SEARCH_DB_PORT=5432
SEARCH_DB_NAME=search_agent_database
SEARCH_DB_USER=postgres
SEARCH_DB_PASSWORD=postgres

# Search MCP is optional
AUTO_START_SEARCH_MCP=false
ENABLE_SEARCH_MCP_CLIENT=false
MCP_SEARCH_SERVER_URL=http://127.0.0.1:8004/mcp

# Client-side port if you later add the ADK web client yourself
CLIENT_WEB_PORT=8030

# Research agent output directory inside the container
RESEARCH_FILE_PATH=/app/research_agent/backend

# RAG agent defaults.
# The rag service is disabled by default in docker-compose.yml and only starts when
# you use: docker compose --profile rag up
LLM_MODEL_PATH=/models/llm
EMBED_PATH=/models/embed
STORAGE_DIR=/app/storage
RAG_LLM_MODEL_DIR=./models/llm
RAG_EMBED_MODEL_DIR=./models/embed
RAG_STORAGE_DIR=./storage
